<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only so the blur lab can pop up a real system dialog over its test pattern (extra "perm"). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No android:enableOnBackInvokedCallback here: the library (iris-navigation) brings it, like it does for any app. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Iris Catalog"
        android:supportsRtl="true"
        android:theme="@style/Theme.Catalog">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
